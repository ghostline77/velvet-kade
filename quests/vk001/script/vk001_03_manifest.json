      "key": "vk001_03_velvet_friend_now",
      "string_id": "6996642977783215546",
      "speaker": "Velvet",
      "addressee": "V",
      "text": "She's out. Got her own place. We talk when she wants to.",
      "audio_path": "mod\\vk001\\localization\\en-us\\vo\\vk001_03_velvet_friend_now.wem",
      "duration_ms": 4720,
      "beat": "friend",
      "female_lipsync_animation": "f_611911B7EEFFF5BA",
      "male_lipsync_animation": "m_611911B7EEFFF5BA"
    },
    {
      "key": "vk001_03_velvet_reward",
      "string_id": "10085675471022865382",
      "speaker": "Velvet",
      "addressee": "V",
      "text": "Your build. Heartbreaker Protocol. You'll find it under Velvet Crash. Six-second optics interruption. The Claws' additions are gone.",
      "audio_path": "mod\\vk001\\localization\\en-us\\vo\\vk001_03_velvet_reward.wem",
      "duration_ms": 8480,
      "beat": "reward",
      "female_lipsync_animation": "f_8BF784679A303BE6",
      "male_lipsync_animation": "m_8BF784679A303BE6"
    },
    {
      "key": "vk001_03_v_reward",
      "string_id": "14332000867347249306",
      "speaker": "V",
      "addressee": "Velvet",
      "text": "Guess I can live with the bows.",
      "audio_path": "mod\\vk001\\localization\\en-us\\vo\\vk001_03_v_reward_f.wem",
      "duration_ms": 2480,
      "beat": "reward",
      "male_audio_path": "mod\\vk001\\localization\\en-us\\vo\\vk001_03_v_reward_m.wem",
      "female_lipsync_animation": "f_C6E57EDACAD2B89A",
      "male_lipsync_animation": "m_C6E57EDACAD2B89A"
    },
    {
      "key": "vk001_03_velvet_close",
      "string_id": "1077986469800269399",
      "speaker": "Velvet",
      "addressee": "V",
      "text": "Give it a try. They look better on someone else's optics.",
      "audio_path": "mod\\vk001\\localization\\en-us\\vo\\vk001_03_velvet_close.wem",
      "duration_ms": 4400,
      "beat": "reward",
      "female_lipsync_animation": "f_0EF5C6FB9D1F5657",
